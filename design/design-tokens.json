 "glyphRules": {
  "wifi": "Всегда рисуйте подложку U+E701 с alpha 0.30, поверх — уровень (E872/E873/E874) с alpha 1; уровень 4 = E701 alpha 1; уровень 0 = только подложка.",
  "battery": "index = pct≥95 ? 10 : pct<5 ? 0 : floor((pct−5)/10)+1; заряжается → BatteryChargingN.",
  "volume": "muted → E74F; 0 → E992; ≤33 % → E993; ≤66 % → E994; иначе E995.",
  "windowsLogo": "Глифа нет — 4 квадрата: сторона (size−1)/2, зазор 1 px; при 14 px → 6.5 + 1 + 6.5.",
  "sizes": {
   "barIconPx": 16,
   "batteryPx": 20,
   "rowGlyphPx": 13,
   "sliderGlyphPx": 13
  }
 },
